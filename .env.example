# ============================================================
# AI Automation Suite (mail-hub + universal-registrar + token-free-gateway)
# Copy to .env: cp .env.example .env
# ============================================================

# --- 1. Mail Hub (Port 3100) ---
PORT=3100
HOST=0.0.0.0
API_SECRET=change-me-to-a-random-string
DB_PATH=./mail-hub/data/mail.db

# --- 2. Universal Registrar ---
UR_CDP_URL=http://127.0.0.1:9222
UR_EMAIL_PROVIDER=mailhub
MAIL_HUB_URL=http://127.0.0.1:3100
MAIL_HUB_API_KEY=change-me-to-a-random-string
# Optional: force specific mail-hub upstream provider (outlook, yyds, imap, mailtm)
MAIL_HUB_PROVIDER=
MAIL_HUB_DOMAIN=

# --- 3. Token-Free Gateway (Port 3456) ---
TFG_PORT=3456
TFG_API_KEY=
TFG_CDP_URL=http://127.0.0.1:9222
