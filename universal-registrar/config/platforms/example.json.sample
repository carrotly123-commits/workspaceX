{
  "id": "example-site",
  "name": "Example Site (template)",
  "signupUrl": "https://example.com/signup",
  "domains": ["example.com"],
  "preferredMode": "semi",
  "needsEmail": true,
  "needsPhone": false,
  "tips": "Copy this file and adjust selectors for your target site. Choose a non-analytics logged-in cookie or a logged-in-only visible selector as proof; if both are configured, both must match. Do not use a generic body selector.",
  "selectors": {
    "openSignup": ["a[href*='signup']", "button:has-text('Sign up')"],
    "email": ["#email", "input[name='email']", "input[type='email']"],
    "password": ["#password", "input[name='password']", "input[type='password']"],
    "name": ["#name", "input[name='name']"],
    "submit": ["button[type='submit']", "button:has-text('Sign up')"],
    "code": ["input[name='code']", "input[autocomplete='one-time-code']"]
  },
  "successCookie": "replace-with-login-cookie-name",
  "emailFromHint": "example.com"
}
